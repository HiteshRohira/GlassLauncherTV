+/* Glass: growable string for resolve_relative_uris */
+typedef struct { char *buf; size_t len, cap; int failed; } _sbuf_t;
+static void _sbuf_put(_sbuf_t *b, const char *s, size_t n) {
+    if (b->failed) return;
+    if (b->len + n + 1 > b->cap) {
+        size_t cap = b->cap ? b->cap : 256;
+        while (cap < b->len + n + 1) {
+            if (cap > SIZE_MAX / 2) { b->failed = 1; return; }
+            cap *= 2;
+        }
+        char *grown = realloc(b->buf, cap);
+        if (!grown) { b->failed = 1; return; }
+        b->buf = grown;
+        b->cap = cap;
+    }
+    memcpy(b->buf + b->len, s, n);
+    b->len += n;
+    b->buf[b->len] = '\0';
+}
+
+static int _is_absolute_uri(const char *uri, size_t len) {
+    for (size_t i = 0; i + 2 < len; i++) {
+        char c = uri[i];
+        if (c == ':') return uri[i + 1] == '/' && uri[i + 2] == '/';
+        if (!(isalnum((unsigned char) c) || c == '+' || c == '-' || c == '.')) return 0;
+    }
+    return 0;
+}
+
+static void _put_resolved(_sbuf_t *b, const char *uri, size_t len, const char *base_url) {
+    if (len == 0 || _is_absolute_uri(uri, len)) {
+        _sbuf_put(b, uri, len);
+        return;
+    }
+    /* base_url without its query or fragment */
+    size_t base_len = strcspn(base_url, "?#");
+    const char *scheme_end = strstr(base_url, "://");
+    size_t authority_end = base_len;
+    if (scheme_end && (size_t) (scheme_end - base_url) < base_len) {
+        const char *path = memchr(scheme_end + 3, '/', base_len - (scheme_end + 3 - base_url));
+        authority_end = path ? (size_t) (path - base_url) : base_len;
+    }
+    if (len > 1 && uri[0] == '/' && uri[1] == '/') {
+        if (scheme_end) _sbuf_put(b, base_url, scheme_end - base_url + 1);  /* scheme-relative */
+    } else if (uri[0] == '/') {
+        _sbuf_put(b, base_url, authority_end);                 /* root-relative */
+    } else {
+        size_t dir = base_len;
+        while (dir > authority_end && base_url[dir - 1] != '/') dir--;
+        if (dir <= authority_end) {
+            _sbuf_put(b, base_url, authority_end);
+            _sbuf_put(b, "/", 1);
+        } else {
+            _sbuf_put(b, base_url, dir);                       /* directory-relative */
+        }
+    }
+    _sbuf_put(b, uri, len);
+}
+
+/* Glass: make every playlist and rendition URI in a master playlist absolute,
+ * resolved against the master's own URL, so that relative variants go through
+ * the same uri_prefix table and rewrite as absolute ones. Returns a new string
+ * (caller frees) or NULL on allocation failure. */
+char *resolve_relative_uris(const char *playlist, const char *base_url) {
+    _sbuf_t b = { 0 };
+    _sbuf_put(&b, "", 0);
+    const char *line = playlist;
+    while (*line) {
+        const char *eol = strchr(line, '\n');
+        size_t line_len = eol ? (size_t) (eol - line) : strlen(line);
+        size_t content_len = line_len;
+        if (content_len && line[content_len - 1] == '\r') content_len--;
+        if (content_len && line[0] != '#') {
+            size_t lead = 0;
+            while (lead < content_len && (line[lead] == ' ' || line[lead] == '\t')) lead++;
+            _sbuf_put(&b, line, lead);
+            _put_resolved(&b, line + lead, content_len - lead, base_url);
+        } else if (content_len > 4 && !strncmp(line, "#EXT", 4)) {
+            const char *p = line, *stop = line + content_len;
+            const char *attr;
+            while ((attr = strstr(p, "URI=\"")) && attr < stop) {
+                const char *value = attr + 5;
+                const char *close = memchr(value, '"', stop - value);
+                if (!close) break;
+                _sbuf_put(&b, p, value - p);
+                _put_resolved(&b, value, close - value, base_url);
+                p = close;
+            }
+            _sbuf_put(&b, p, stop - p);
+        } else {
+            _sbuf_put(&b, line, content_len);
+        }
+        _sbuf_put(&b, line + content_len, line_len - content_len);  /* keep any \r */
+        if (!eol) break;
+        _sbuf_put(&b, "\n", 1);
+        line = eol + 1;
+    }
+    if (b.failed) {
+        free(b.buf);
+        return NULL;
+    }
+    return b.buf;
+}
+
 static char *_quoted_field(const char *hay, const char *key, size_t *len) {
     const char *begin = strstr(hay, key);
     if (begin) begin = strchr(begin, '"');
