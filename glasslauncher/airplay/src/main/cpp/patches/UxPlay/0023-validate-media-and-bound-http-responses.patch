diff --git a/lib/control_query.h b/lib/control_query.h
new file mode 100644
index 0000000..9b7fdfa
--- /dev/null
+++ b/lib/control_query.h
@@ -0,0 +1,26 @@
+#ifndef CONTROL_QUERY_H
+#define CONTROL_QUERY_H
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <errno.h>
+static int http_control_number(const char *url, const char *key, double *value) {
+    const char *p = strchr(url, '?');
+    if (!p) return 0;
+    size_t n = strlen(key);
+    for (++p; *p;) {
+        const char *next = strchr(p, '&');
+        size_t len = next ? (size_t)(next-p) : strlen(p);
+        if (len > n+1 && !strncmp(p, key, n) && p[n] == '=') {
+            char *end = NULL;
+            errno = 0;
+            double v = strtod(p+n+1, &end);
+            if (errno || end == p+n+1 || end != p+len || !isfinite(v)) return 0;
+            *value = v; return 1;
+        }
+        if (!next) break;
+        p = next+1;
+    }
+    return 0;
+}
+#endif
