diff --git a/lib/mirror_config.h b/lib/mirror_config.h
new file mode 100644
index 0000000..6429e89
--- /dev/null
+++ b/lib/mirror_config.h
@@ -0,0 +1,48 @@
+/* Bounds-checked codec configuration; no decoder/session policy. */
+#ifndef MIRROR_CONFIG_H
+#define MIRROR_CONFIG_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+static int mirror_config_parse(const unsigned char *data, size_t size,
+                               unsigned char *out, size_t capacity,
+                               size_t *written, int *hevc) {
+    size_t offsets[3], lengths[3], count = 0, total = 0;
+    *written = 0;
+    if (!data || size < 8) return 0;
+    *hevc = !memcmp(data + 4, "hvc1", 4);
+    if (*hevc) {
+        size_t pos = 0x75;
+        for (size_t i = 0; i < 3; ++i) {
+            if (pos > size || size - pos < 5) return 0;
+            if (data[pos] != 0xa0 + i || data[pos+1] != 0 || data[pos+2] != 1) return 0;
+            size_t n = ((size_t)data[pos+3] << 8) | data[pos+4];
+            pos += 5;
+            if (!n || n > size - pos) return 0;
+            offsets[count] = pos; lengths[count++] = n; pos += n;
+        }
+    } else {
+        size_t n = ((size_t)data[6] << 8) | data[7];
+        if (!n || n > size - 8) return 0;
+        offsets[0] = 8; lengths[0] = n;
+        size_t pos = 8 + n;
+        if (size - pos < 3) return 0;
+        n = ((size_t)data[pos+1] << 8) | data[pos+2];
+        pos += 3;
+        if (!n || n > size - pos) return 0;
+        offsets[1] = pos; lengths[1] = n; count = 2;
+    }
+    for (size_t i = 0; i < count; ++i) {
+        if (capacity - total < 4 || lengths[i] > capacity - total - 4) return 0;
+        total += 4 + lengths[i];
+    }
+    size_t pos = 0;
+    for (size_t i = 0; i < count; ++i) {
+        const unsigned char start[] = {0,0,0,1};
+        memcpy(out+pos,start,4); pos += 4;
+        memcpy(out+pos,data+offsets[i],lengths[i]); pos += lengths[i];
+    }
+    *written = total;
+    return 1;
+}
+#endif
