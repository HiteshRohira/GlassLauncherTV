# Build artefacts ──────────────────────────────────────────────────────
# Gradle outputs and caches. Regenerated on every build.
build/
.gradle/
out/

# Per-developer local config — contains absolute SDK paths and is never
# the same across machines. Must never be committed.
local.properties

# Gradle wrapper jar/scripts. Only the wrapper *properties* file is
# tracked; scripts/release.py runs a local Gradle install instead. If you
# generate the wrapper locally, do not commit it.
gradlew
gradlew.bat
gradle/wrapper/gradle-wrapper.jar
glasslauncher/gradlew
glasslauncher/gradlew.bat
glasslauncher/gradle/wrapper/gradle-wrapper.jar

# IDE noise ──────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
.fleet/

# Android Studio
captures/
.externalNativeBuild/
.cxx/

# Release builds from scripts/release.py.
dist/

# Signing material — must NEVER be committed. scripts/release.py reads
# the keystore from a path outside the repo.
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
release.properties

# OS clutter ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Generated reports / logs (rare locally, but block them anyway) ────────
*.log
*.hprof
test-results/
reports/

# Isolated native-size comparison outputs
.build/
